{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "paths": { "@webmcp-dev/sdk": ["./src/sdk.ts"] },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "chrome"],
    "noEmit": true
  },
  "include": ["src", "extension/*.ts", "tests", "playwright.config.ts"]
}
