{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WebMCP Dev site plugin",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "id", "name", "version", "description", "matches"],
  "properties": {
    "$schema": { "type": "string" },
    "apiVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "minLength": 1 },
    "matches": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(https?|\\*):\\/\\/(\\*\\.)?[a-z0-9.-]+\\/[^\\s]*$" } }
  }
}
