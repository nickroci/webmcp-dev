{
  "manifest_version": 3,
  "name": "WebMCP Dev",
  "version": "0.4.0",
  "description": "Automatically load site plugins and inspect, test, and call their WebMCP tools.",
  "minimum_chrome_version": "120",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "WebMCP Dev",
    "default_popup": "popup.html"
  }
}
